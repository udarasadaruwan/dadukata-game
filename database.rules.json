{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",

        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['color', 'connected', 'joinedAt', 'displayName'])"
          }
        },
        "positions": {
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        },
        "winCounts": {
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "dice": {
          ".validate": "!newData.exists() || newData.hasChildren(['value', 'rolledBy', 'rolledAt'])",
          "value": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
          },
          "rolledBy": { ".validate": "newData.isString()" },
          "rolledAt": { ".validate": "newData.isNumber()" }
        },
        "lastMove": {
          ".validate": "!newData.exists() || newData.hasChildren(['playerId', 'from', 'to', 'intermediate', 'diceValue', 'timestamp'])"
        },
        "reaction": {
          ".validate": "!newData.exists() || newData.hasChildren(['emoji', 'playerId', 'timestamp'])",
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "playerId": { ".validate": "newData.isString()" },
          "timestamp": { ".validate": "newData.isNumber()" }
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
        },
        "turn": { ".validate": "newData.isString()" },
        "winner": { ".validate": "!newData.exists() || newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
